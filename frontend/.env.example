# Mock 开发覆盖可复制为 .env.development.local。
# dev:real 已由 .env.real 启用真实接口；自定义后端时请按《前端快速启动说明》单独创建 .env.real.local，不要照搬下方的 mock 模式值。
# mock：使用与《API 接口文档.md》同结构的内置数据；real：请求真实后端。
VITE_API_MODE=mock

# 必须包含 API 文档规定的 /api/v1 前缀。
VITE_API_BASE_URL=/api/v1

# 仅 Mock 模式使用，单位毫秒。测试可设置为 0。
VITE_MOCK_DELAY=120

# 可选：设置为 true 时，除初始化状态外的 Mock 请求统一返回 503。
VITE_MOCK_FORCE_ERROR=false

# Vite 开发代理目标，仅 real 模式且使用相对 API 地址时需要。
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
