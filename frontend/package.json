{
  "name": "yuque-backup-admin",
  "type": "module",
  "version": "1.1.1",
  "private": true,
  "packageManager": "pnpm@10.29.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3002",
    "dev:mock": "vite --mode mock --host 127.0.0.1 --port 3002",
    "dev:real": "vite --mode real --host 127.0.0.1 --port 3002",
    "build": "vite build",
    "build:mock": "vite build --mode mock",
    "build:check": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b --force"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@vueuse/core": "^14.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.29",
    "vue-router": "^4.6.4",
    "vue-sonner": "^2.0.9",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^28.1.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.3.1",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "pnpm": {
    "overrides": {
      "vite": "npm:rolldown-vite@7.3.1"
    }
  }
}
