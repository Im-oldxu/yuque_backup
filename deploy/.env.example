# 默认拉取当前仓库发布到 GHCR 的 latest 镜像。固定版本或回滚时改为 vX.Y.Z。
YUQUE_BACKUP_IMAGE=ghcr.io/im-oldxu/yuque_backup:latest

# 必填：URL-safe Base64 或 hex 编码的 32 字节密钥。部署后不得更换或遗失。
APP_MASTER_KEY=replace-with-a-32-byte-url-safe-base64-key

# 本地 HTTP 快速运行默认值。公网 HTTPS 部署改为 production/true，并填写实际 HTTPS Origin。
APP_ENV=development
SECURE_COOKIES=false
TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

TZ=Asia/Shanghai
BIND_ADDRESS=127.0.0.1
APP_PORT=8000
